{
  "name": "reading-tracker",
  "version": "1.0.0",
  "description": "Book reading tracker application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup": "node backup.js",
    "dev": "nodemon server.js",
    "build": "npx playwright install chromium && npx puppeteer browsers install chrome",
    "postinstall": "npx playwright install chromium && npx puppeteer browsers install chrome",
    "docker:build": "docker build -t reading-tracker .",
    "docker:run": "docker run --rm -p 3001:3000 --env-file .env reading-tracker",
    "docker:dev": "docker build -t reading-tracker . && docker run --rm -p 3001:3000 --env-file .env reading-tracker",
    "whatsapp:send-poll": "node whatsapp/send-poll-native.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.17",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "clean-css": "^5.3.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "dropbox": "^10.34.0",
    "ejs": "^5.0.2",
    "express": "^4.22.2",
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "moment": "^2.30.1",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.1",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "pino": "^9.7.0",
    "playwright": "^1.62.1",
    "puppeteer": "^25.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "request-ip": "^3.3.0",
    "selenium-webdriver": "^4.33.0",
    "sharp": "^0.34.5",
    "terser": "^5.44.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "nodemon": "^3.1.14"
  }
}
