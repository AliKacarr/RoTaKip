{
  "name": "reading-tracker",
  "version": "1.0.0",
  "description": "Book reading tracker application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup": "node backup.js",
    "dev": "nodemon server.js",
    "build": "npx playwright install chromium",
    "postinstall": "npx playwright install chromium",
    "docker:build": "docker build -t reading-tracker .",
    "docker:run": "docker run --rm -p 3001:3000 --env-file .env reading-tracker",
    "docker:dev": "docker build -t reading-tracker . && docker run --rm -p 3001:3000 --env-file .env reading-tracker"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "clean-css": "^5.3.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "dropbox": "^10.34.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "moment": "^2.30.1",
    "mongodb": "^7.2.0",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "request-ip": "^3.3.0",
    "selenium-webdriver": "^4.33.0",
    "sharp": "^0.35.3",
    "terser": "^5.49.2"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "nodemon": "^3.1.14"
  }
}
