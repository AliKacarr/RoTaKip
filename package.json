{
  "name": "reading-tracker",
  "version": "1.0.0",
  "description": "Book reading tracker application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:assets": "node scripts/build-assets.js",
    "predev": "npm run build:assets",
    "dev": "node --watch server.js",
    "test": "node --test tests/erpUsersSync.test.js tests/erpReadingsSync.test.js",
    "sync:erp-users": "node anket/erpUsersSync.js",
    "sync:erp-users:dry-run": "node anket/erpUsersSync.js --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run build:assets",
    "postinstall": "npm run build:assets && npx playwright install chromium",
    "docker:build": "docker build -t reading-tracker .",
    "docker:run": "docker run --rm -p 3001:3000 --env-file .env reading-tracker",
    "docker:dev": "docker build -t reading-tracker . && docker run --rm -p 3001:3000 --env-file .env reading-tracker"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "clean-css": "^5.3.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "dropbox": "^10.47.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "moment": "^2.30.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.11.2",
    "multer": "^2.5.0",
    "node-schedule": "^2.1.1",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
