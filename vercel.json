{
  "version": 3,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://rotakip.onrender.com/api/$1" },
    { "source": "/images/(.*)", "destination": "https://rotakip.onrender.com/images/$1" },
    { "source": "/uploads/(.*)", "destination": "https://rotakip.onrender.com/uploads/$1" },
    { "source": "/groupImages/(.*)", "destination": "https://rotakip.onrender.com/groupImages/$1" },
    { "source": "/groupAvatars/(.*)", "destination": "https://rotakip.onrender.com/groupAvatars/$1" },
    { "source": "/userAvatars/(.*)", "destination": "https://rotakip.onrender.com/userAvatars/$1" },
    { "source": "/quotes/(.*)", "destination": "https://rotakip.onrender.com/quotes/$1" },
    { "source": "/groupid=([a-zA-Z0-9_-]+)", "destination": "/groups.html" }
  ],
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "*/3 * * * *"
    }
  ]
}

